{
  "name": "hut-miniapp",
  "version": "0.2.0",
  "private": true,
  "description": "Telegram Mini App: сборщик состава HUT + маркет (данные hutdb.app), доступ по подписке за звёзды",
  "scripts": {
    "sync": "node scripts/sync-hutdb.js",
    "build": "node scripts/build-site.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node scripts/build-site.js && node --test tests/*.test.mjs",
    "dev:open": "node scripts/dev-open.js"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=18"
  }
}
